<UserControl
    x:Class="UrToolClient.Views.CalibrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  主要操作按钮  -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#18181B" />
            <Setter Property="Foreground" Value="#FAFAFA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsEnabled}" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F3F46" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#A1A1AA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  危险按钮（删除）  -->
        <Style
            x:Key="DangerBtn"
            BasedOn="{StaticResource PrimaryBtn}"
            TargetType="Button">
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="Foreground" Value="#991B1B" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FECACA" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F4F4F5" />
                    <Setter Property="Foreground" Value="#A1A1AA" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  次级按钮  -->
        <Style
            x:Key="SecondaryBtn"
            BasedOn="{StaticResource PrimaryBtn}"
            TargetType="Button">
            <Setter Property="Background" Value="#F4F4F5" />
            <Setter Property="Foreground" Value="#3F3F46" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E4E4E7" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F4F4F5" />
                    <Setter Property="Foreground" Value="#A1A1AA" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  自由驱动开关按钮（激活时变绿）  -->
        <Style
            x:Key="FreedrivBtn"
            BasedOn="{StaticResource PrimaryBtn}"
            TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFreedriveActive}" Value="True">
                    <Setter Property="Background" Value="#16A34A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!--  ── 顶部工具栏 ─────────────────────────────────────────  -->
        <Border
            Padding="16,12"
            Background="#FFFFFF"
            BorderBrush="#E4E4E7"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#18181B"
                        Text="仓位标定" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#A1A1AA"
                        Text=" — 示教点位记录" />
                </StackPanel>

                <!--  右侧操作按钮  -->
                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <!--  自由驱动开关  -->
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding ToggleFreedriveModeCommand}"
                        Content="{Binding FreedriveButtonText}"
                        Style="{StaticResource FreedrivBtn}" />
                    <!--  记录当前点位  -->
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding RecordPointCommand}"
                        Content="⊕  记录当前点位"
                        Style="{StaticResource PrimaryBtn}" />
                    <!--  复制全部  -->
                    <Button
                        Command="{Binding CopyAllPointsCommand}"
                        Content="复制全部"
                        Style="{StaticResource SecondaryBtn}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  ── 底部状态栏 ─────────────────────────────────────────  -->
        <Border
            Padding="16,8"
            Background="#FAFAFA"
            BorderBrush="#E4E4E7"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <TextBlock
                FontSize="11"
                Foreground="#52525B"
                Text="{Binding StatusText}"
                TextWrapping="Wrap" />
        </Border>

        <!--  ── 主体：左侧列表 + 右侧详情 ──────────────────────────  -->
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <!--  点位列表  -->
            <Border
                Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="#E4E4E7"
                BorderThickness="1"
                CornerRadius="8">
                <DockPanel>
                    <!--  列表头  -->
                    <Border
                        Padding="12,8"
                        Background="#F4F4F5"
                        BorderBrush="#E4E4E7"
                        BorderThickness="0,0,0,1"
                        DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="#A1A1AA"
                                Style="{StaticResource {x:Type TextBlock}}"
                                Text="#" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="#A1A1AA"
                                Text="名称" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="#A1A1AA"
                                Text="J1 (°)" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="#A1A1AA"
                                Text="J2 (°)" />
                            <TextBlock
                                Grid.Column="4"
                                HorizontalAlignment="Center"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="#A1A1AA"
                                Text="J3 (°)" />
                            <TextBlock
                                Grid.Column="5"
                                HorizontalAlignment="Center"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="#A1A1AA"
                                Text="J4 (°)" />
                            <TextBlock
                                Grid.Column="6"
                                HorizontalAlignment="Center"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="#A1A1AA"
                                Text="J5 (°)" />
                            <TextBlock
                                Grid.Column="7"
                                HorizontalAlignment="Center"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="#A1A1AA"
                                Text="J6 (°)" />
                            <TextBlock
                                Grid.Column="8"
                                HorizontalAlignment="Center"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="#A1A1AA"
                                Text="时间" />
                        </Grid>
                    </Border>

                    <!--  列表内容  -->
                    <ListBox
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Points}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedPoint}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                x:Name="Bg"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="#F4F4F5"
                                                BorderThickness="0,0,0,1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#F4F4F5" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#EFF6FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="#A1A1AA"
                                        Text="{Binding Index}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="11"
                                        FontWeight="Medium"
                                        Foreground="#18181B"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="#3F3F46"
                                        Text="{Binding J1Deg, StringFormat={}{0:F2}}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="#3F3F46"
                                        Text="{Binding J2Deg, StringFormat={}{0:F2}}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="#3F3F46"
                                        Text="{Binding J3Deg, StringFormat={}{0:F2}}" />
                                    <TextBlock
                                        Grid.Column="5"
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="#3F3F46"
                                        Text="{Binding J4Deg, StringFormat={}{0:F2}}" />
                                    <TextBlock
                                        Grid.Column="6"
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="#3F3F46"
                                        Text="{Binding J5Deg, StringFormat={}{0:F2}}" />
                                    <TextBlock
                                        Grid.Column="7"
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="#3F3F46"
                                        Text="{Binding J6Deg, StringFormat={}{0:F2}}" />
                                    <TextBlock
                                        Grid.Column="8"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="#A1A1AA"
                                        Text="{Binding RecordedAt, StringFormat='HH:mm:ss'}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!--  右侧：点位名称输入 + 选中点操作  -->
            <StackPanel Grid.Column="2">
                <!--  新点位名称  -->
                <Border
                    Padding="14"
                    Background="#FFFFFF"
                    BorderBrush="#E4E4E7"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="11"
                            Foreground="#A1A1AA"
                            Text="点位名称" />
                        <Border
                            BorderBrush="#E4E4E7"
                            BorderThickness="1"
                            CornerRadius="5">
                            <TextBox
                                Padding="8,6"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="12"
                                Foreground="#18181B"
                                Text="{Binding NewPointName, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="10"
                            Foreground="#A1A1AA"
                            Text="下次点击「记录当前点位」时使用此名称。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  选中点位操作  -->
                <Border
                    Margin="0,8,0,0"
                    Padding="14"
                    Background="#FFFFFF"
                    BorderBrush="#E4E4E7"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="11"
                            Foreground="#A1A1AA"
                            Text="选中点位操作" />

                        <!--  选中点名称显示  -->
                        <Border
                            Margin="0,0,0,10"
                            Padding="10,7"
                            Background="#F4F4F5"
                            CornerRadius="5">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="#3F3F46">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="（未选择）" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPoint}" Value="{x:Null}">
                                                <Setter Property="Foreground" Value="#A1A1AA" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="{Binding SelectedPoint.Name, FallbackValue='（未选择）'}" />
                            </TextBlock>
                        </Border>

                        <!--  回放  -->
                        <Button
                            Margin="0,0,0,6"
                            HorizontalAlignment="Stretch"
                            Command="{Binding PlaybackPointCommand}"
                            Content="▶  回放到此点位"
                            Style="{StaticResource PrimaryBtn}" />
                        <!--  复制单个  -->
                        <Button
                            Margin="0,0,0,6"
                            HorizontalAlignment="Stretch"
                            Command="{Binding CopyPointCommand}"
                            Content="复制关节角"
                            Style="{StaticResource SecondaryBtn}" />
                        <!--  删除  -->
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{Binding DeletePointCommand}"
                            Content="删除此点位"
                            Style="{StaticResource DangerBtn}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
