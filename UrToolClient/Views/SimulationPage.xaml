<UserControl
    x:Class="UrToolClient.Views.SimulationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
    xmlns:local="clr-namespace:UrToolClient.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Margin="0,0,16,0"
            Padding="16"
            Background="#FFFFFF"
            BorderBrush="#E4E4E7"
            BorderThickness="1"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="8"
                    Opacity="0.03"
                    ShadowDepth="2"
                    Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="#18181B"
                    Text="数字孪生仿真" />

                <Button
                    Height="36"
                    Margin="0,0,0,24"
                    Background="#18181B"
                    BorderThickness="0"
                    Command="{Binding LoadRobotCommand}"
                    Content="加载 UR10e 模型"
                    Cursor="Hand"
                    Foreground="#FAFAFA">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock
                    Margin="0,0,0,12"
                    FontSize="11"
                    Foreground="#A1A1AA"
                    Text="正向运动学测试 (关节)" />

                <ItemsControl ItemsSource="{Binding Joints}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Foreground="#3F3F46"
                                        Text="{Binding JointName}" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        DockPanel.Dock="Right"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        Foreground="#22C55E"
                                        Text="{Binding AngleDegree, StringFormat={}{0:F2}°}" />
                                </DockPanel>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    Maximum="360"
                                    Minimum="-360"
                                    TickFrequency="1"
                                    Value="{Binding AngleDegree, Mode=TwoWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border
            Grid.Column="1"
            Background="#27272A"
            ClipToBounds="True"
            CornerRadius="8">
            <hx:Viewport3DX
                BackgroundColor="#27272A"
                EffectsManager="{Binding EffectsManager}"
                EnableSwapChainRendering="True"
                ShowCoordinateSystem="True">
                <hx:Viewport3DX.Camera>
                    <hx:PerspectiveCamera
                        FarPlaneDistance="100"
                        LookDirection="0, -1, -0.5"
                        NearPlaneDistance="0.01"
                        Position="0, 2, 1"
                        UpDirection="0, 0, 1" />
                </hx:Viewport3DX.Camera>

                <hx:DirectionalLight3D Direction="-1, -1, -1" Color="White" />
                <hx:DirectionalLight3D Direction="1, 1, 1" Color="#888888" />
                <hx:AmbientLight3D Color="#888888" />

                <hx:ItemsModel3D ItemsSource="{Binding SceneModels}" />
            </hx:Viewport3DX>
        </Border>
    </Grid>
</UserControl>
