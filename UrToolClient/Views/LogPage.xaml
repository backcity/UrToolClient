<UserControl x:Class="UrToolClient.Views.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>
        <!-- 标题栏 -->
        <Border DockPanel.Dock="Top"
                Padding="12,10,8,10"
                BorderBrush="#E4E4E7"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="运行日志"
                           FontSize="12" FontWeight="Medium"
                           Foreground="#18181B"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right"
                        Content="清空"
                        Command="{Binding ClearLogsCommand}"
                        FontSize="10" Foreground="#A1A1AA"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- 日志列表 -->
        <ScrollViewer x:Name="Scroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Logs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,4"
                                BorderBrush="#F4F4F5"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <!-- 时间 + 级别 -->
                                <DockPanel>
                                    <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                               FontSize="10" Foreground="#A1A1AA"
                                               FontFamily="Consolas"/>
                                    <Border DockPanel.Dock="Right"
                                            CornerRadius="3"
                                            Padding="4,1"
                                            Background="{Binding LevelBackground}"
                                            Margin="4,0,0,0">
                                        <TextBlock Text="{Binding LogLevel}"
                                                   FontSize="9" FontWeight="Medium"
                                                   Foreground="{Binding LevelForeground}"/>
                                    </Border>
                                </DockPanel>
                                <!-- 消息内容 -->
                                <TextBlock Text="{Binding Message}"
                                           FontSize="11"
                                           Foreground="#3F3F46"
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>