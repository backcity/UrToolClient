<Window
    x:Class="UrToolClient.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UrToolClient.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:UrToolClient.Views"
    Width="1440"
    Height="1260"
    Background="#F4F4F5"
    mc:Ignorable="d">


    <Window.Resources>
        <!--  导航菜单项样式 (合并了普通和激活状态)  -->
        <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#52525B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <!--  移除 RadioButton 默认的小圆点，完全自定义外观  -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="BgBorder"
                            Margin="8,2"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  鼠标悬浮状态  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#E4E4E7" />
                                <Setter Property="Foreground" Value="#18181B" />
                            </Trigger>

                            <!--  按钮被按下时的状态  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#D4D4D8" />
                            </Trigger>

                            <!--  ★ 核心：被选中(激活)时的状态 ★  -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#18181B" />
                                <Setter Property="Foreground" Value="#FAFAFA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!--  菜单栏 固定左侧  -->
            <ColumnDefinition Width="200" />
            <!--  内容  -->
            <ColumnDefinition Width="*" />
            <!--  右侧固定日志或者其他信息  -->
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <!--  菜单  -->
        <Border
            Grid.Column="0"
            Background="#FFFFFF"
            BorderBrush="#E4E4E7"
            BorderThickness="0,0,1,0">
            <DockPanel>
                <!--  顶部标题  -->
                <Border
                    Padding="16,16,16,12"
                    BorderBrush="#E4E4E7"
                    BorderThickness="0,0,0,1"
                    DockPanel.Dock="Top">
                    <StackPanel>
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#18181B"
                            Text="UR Tool" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="#A1A1AA"
                            Text="仓位标定工具" />
                    </StackPanel>
                </Border>

                <!--  连接状态 + 控制按钮  -->
                <Border
                    Padding="12,12"
                    BorderBrush="#E4E4E7"
                    BorderThickness="0,1,0,0"
                    DockPanel.Dock="Bottom">
                    <StackPanel>
                        <!--  IP 输入框  -->
                        <TextBox
                            Margin="0,0,0,8"
                            Padding="8,5"
                            Background="#F4F4F5"
                            BorderBrush="#E4E4E7"
                            BorderThickness="1"
                            FontSize="11"
                            Foreground="#3F3F46"
                            Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="5">
                                                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!--  状态指示 + 连接/断开按钮  -->
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#EF4444" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="#22C55E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#52525B"
                                    Text="{Binding ConnectionStatus}" />
                            </StackPanel>

                            <!--  连接 / 断开 按钮  -->
                            <Button
                                Padding="10,4"
                                HorizontalAlignment="Right"
                                BorderThickness="1"
                                Cursor="Hand"
                                DockPanel.Dock="Right"
                                FontSize="11">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#18181B" />
                                        <Setter Property="Foreground" Value="#FAFAFA" />
                                        <Setter Property="BorderBrush" Value="#18181B" />
                                        <Setter Property="Command" Value="{Binding ConnectCommand}" />
                                        <Setter Property="Content" Value="连接" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5">
                                                        <ContentPresenter
                                                            Margin="{TemplateBinding Padding}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#3F3F46" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Background" Value="#52525B" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Background" Value="#FEE2E2" />
                                                <Setter Property="Foreground" Value="#991B1B" />
                                                <Setter Property="BorderBrush" Value="#FECACA" />
                                                <Setter Property="Command" Value="{Binding DisconnectCommand}" />
                                                <Setter Property="Content" Value="断开" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!--  导航菜单  -->
                <StackPanel Margin="0,8" DockPanel.Dock="Top">
                    <TextBlock
                        Margin="16,4,0,4"
                        FontSize="10"
                        FontWeight="Medium"
                        Foreground="#A1A1AA"
                        Text="功能" />

                    <!--  使用 RadioButton，加上 GroupName，默认选中第一个  -->
                    <RadioButton
                        Command="{Binding ChangePageCommand}"
                        CommandParameter="CalibrationView"
                        Content="▸  仓位标定"
                        GroupName="NavMenu"
                        IsChecked="True"
                        Style="{StaticResource NavRadioButtonStyle}" />

                    <RadioButton
                        Command="{Binding ChangePageCommand}"
                        CommandParameter="VariablesView"
                        Content="▸  安装设置"
                        GroupName="NavMenu"
                        Style="{StaticResource NavRadioButtonStyle}" />

                    <RadioButton
                        Content="▸  脚本发送"
                        GroupName="NavMenu"
                        Style="{StaticResource NavRadioButtonStyle}" />

                    <RadioButton
                        Command="{Binding ChangePageCommand}"
                        CommandParameter="SimulationView"
                        Content="▸  3 D仿真(学习DH)"
                        GroupName="NavMenu"
                        Style="{StaticResource NavRadioButtonStyle}" />

                    <TextBlock
                        Margin="16,12,0,4"
                        FontSize="10"
                        FontWeight="Medium"
                        Foreground="#A1A1AA"
                        Text="设置" />

                    <RadioButton
                        Content="▸  连接配置"
                        GroupName="NavMenu"
                        Style="{StaticResource NavRadioButtonStyle}" />

                    <RadioButton
                        Content="▸  参数设置"
                        GroupName="NavMenu"
                        Style="{StaticResource NavRadioButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  中间区域  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  固定在顶部的状态面板  -->
                <RowDefinition Height="*" />
                <!--  下方用于切换的动态页面  -->
            </Grid.RowDefinitions>

            <!--  固定的TCP位姿 与 关节角度 面板  -->
            <Border
                Grid.Row="0"
                Margin="16,16,16,8"
                Padding="16"
                Background="#FFFFFF"
                BorderBrush="#E4E4E7"
                BorderThickness="1"
                CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="8"
                        Opacity="0.03"
                        ShadowDepth="2"
                        Color="#000000" />
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <!--  中间垂直分割线  -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  左侧：TCP 位姿  -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel.InputBindings>
                            <MouseBinding Command="{Binding CopyTcpCommand}" MouseAction="LeftClick" />
                        </StackPanel.InputBindings>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#18181B"
                                Text="TCP 位姿" />
                            <TextBlock
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                FontSize="11"
                                Foreground="#22C55E"
                                Text="{Binding TcpCopyHint}" />
                        </DockPanel>
                        <UniformGrid
                            VerticalAlignment="Top"
                            Columns="3"
                            Rows="2">
                            <!--  X, Y, Z  -->
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="X (mm)" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="#3F3F46"
                                    Text="{Binding TcpX, StringFormat={}{0:F2}, FallbackValue=0.00}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="Y (mm)" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="#3F3F46"
                                    Text="{Binding TcpY, StringFormat={}{0:F2}, FallbackValue=0.00}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="Z (mm)" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="#3F3F46"
                                    Text="{Binding TcpZ, StringFormat={}{0:F2}, FallbackValue=0.00}" />
                            </StackPanel>

                            <!--  Rx, Ry, Rz  -->
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="Rx (rad)" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="#3F3F46"
                                    Text="{Binding TcpRX, StringFormat={}{0:F3}, FallbackValue=0.000}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="Ry (rad)" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="#3F3F46"
                                    Text="{Binding TcpRY, StringFormat={}{0:F3}, FallbackValue=0.000}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="Rz (rad)" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="#3F3F46"
                                    Text="{Binding TcpRZ, StringFormat={}{0:F3}, FallbackValue=0.000}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>

                    <!--  中间分割线  -->
                    <Border
                        Grid.Column="1"
                        Margin="0,4"
                        Background="#F4F4F5" />

                    <!--  右侧：关节角度  -->
                    <StackPanel Grid.Column="2" Margin="16,0,0,0">
                        <StackPanel.InputBindings>
                            <MouseBinding Command="{Binding CopyJointCommand}" MouseAction="LeftClick" />
                        </StackPanel.InputBindings>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#18181B"
                                Text="关节角度" />
                            <TextBlock
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                FontSize="11"
                                Foreground="#22C55E"
                                Text="{Binding JointCopyHint}" />
                        </DockPanel>
                        <UniformGrid
                            VerticalAlignment="Top"
                            Columns="3"
                            Rows="2">
                            <!--  Base, Shoulder, Elbow  -->
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="Base (°)" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="#3F3F46"
                                    Text="{Binding JointBase, StringFormat={}{0:F2}, FallbackValue=0.00}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="Shoulder (°)" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="#3F3F46"
                                    Text="{Binding JointShoulder, StringFormat={}{0:F2}, FallbackValue=0.00}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="Elbow (°)" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="#3F3F46"
                                    Text="{Binding JointElbow, StringFormat={}{0:F2}, FallbackValue=0.00}" />
                            </StackPanel>

                            <!--  Wrist 1, 2, 3  -->
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="Wrist 1 (°)" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="#3F3F46"
                                    Text="{Binding JointWrist1, StringFormat={}{0:F2}, FallbackValue=0.00}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="Wrist 2 (°)" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="#3F3F46"
                                    Text="{Binding JointWrist2, StringFormat={}{0:F2}, FallbackValue=0.00}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#A1A1AA"
                                    Text="Wrist 3 (°)" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="#3F3F46"
                                    Text="{Binding JointWrist3, StringFormat={}{0:F2}, FallbackValue=0.00}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  动态页面容器：当你点击左侧菜单时，这里的内容会被替换  -->
            <ContentControl
                Grid.Row="1"
                Margin="16,8,16,16"
                Content="{Binding CurrentView}">
                <!--  如果不使用 MVVM，这里可以直接放 Frame 进行页面导航  -->
            </ContentControl>

        </Grid>
        <Border
            Grid.Column="2"
            Background="#FFFFFF"
            BorderBrush="#E4E4E7"
            BorderThickness="1,0,0,0">
            <views:LogPage />
        </Border>


    </Grid>
</Window>
