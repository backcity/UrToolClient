<UserControl
    x:Class="UrToolClient.Views.VariablesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UrToolClient.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="10" Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="12"
            Background="White"
            BorderBrush="#EAEAEA"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Button
                        Width="110"
                        Height="32"
                        Margin="0,0,10,0"
                        Background="#4CAF50"
                        BorderThickness="0"
                        Command="{Binding AddVariableCommand}"
                        Content="➕ 新增变量"
                        Foreground="White" />
                    <Button
                        Width="110"
                        Height="32"
                        Background="#F44336"
                        BorderThickness="0"
                        Command="{Binding DeleteVariableCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=VarDataGrid}"
                        Content="❌ 删除选择"
                        Foreground="White" />
                    <Button
                        Width="110"
                        Height="32"
                        Margin="30,0,0,0"
                        Command="{Binding LoadVariablesCommand}"
                        Content="🔄 重新加载" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Foreground="#777777"
                        Text="文件时间戳: " />
                    <TextBlock
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="#333333"
                        Text="{Binding Timestamp}" />
                    <Button
                        Width="180"
                        Height="32"
                        Background="#007ACC"
                        BorderThickness="0"
                        Command="{Binding SaveVariablesCommand}"
                        Content="💾 保存并重写本地 XML"
                        FontWeight="Bold"
                        Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Background="White"
            BorderBrush="#EAEAEA"
            BorderThickness="1"
            CornerRadius="4">
            <DataGrid
                x:Name="VarDataGrid"
                AutoGenerateColumns="False"
                Background="Transparent"
                BorderThickness="0"
                CanUserAddRows="False"
                GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="#F0F0F0"
                ItemsSource="{Binding Variables}"
                RowHeaderWidth="0"
                RowHeight="36"
                SelectionMode="Single">

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        Header=" 变量名 (Name)">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="IsEnabled" Value="{Binding IsNameEditable}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNameEditable}" Value="False">
                                        <Setter Property="Background" Value="#F5F6F8" />
                                        <Setter Property="Foreground" Value="#999999" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="350"
                        Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                        Header=" 数据 (Value)">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridCheckBoxColumn
                        Width="80"
                        Binding="{Binding IsFavourite, UpdateSourceTrigger=PropertyChanged}"
                        Header=" 收藏 (Fav)">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                        Header=" 变量描述 (Description)" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
